---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const importMap = JSON.stringify({
  imports: { [`${base}/pagefind/pagefind.js`]: `${base}/pagefind-rerank.js` },
});

/* The page's markdown twin (src/integrations/page-markdown.mjs writes it to
   <page>/index.md). Utility pages under <StarlightPage> (404, changelog) have
   no twin and opt out of the page chrome with `hideMeta`, the same flag
   PageTitle.astro reads for View as Markdown. */
const route: any = (Astro as any).locals?.starlightRoute;
const hasTwin = route?.entry && (route.entry.data as any)?.hideMeta !== true;
const twinUrl = hasTwin && Astro.site
  ? new URL(`${Astro.url.pathname.replace(/\/?$/, '/')}index.md`, Astro.site).href
  : null;
---
{/* Search ranking: route the search modal's Pagefind import through
    public/pagefind-rerank.js, which moves title matches to the top. An import
    map only applies to module scripts that load after it, so it stays first. */}
<script is:inline type="importmap" set:html={importMap} />
{/* Anti-FOUC: set background + disable VT animations before any external CSS */}
<style is:inline>
  html { background: hsl(224, 10%, 10%); }
  html[data-theme='light'] { background: #fff; }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none !important;
    mix-blend-mode: normal !important;
  }
</style>
{/* Preconnect + non-blocking font load. Replaces a @import in custom.css that
    was re-evaluating on every view transition and causing visible style flicker. */}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
/>
{/* Feed autodiscovery: lets a reader (or a reader's RSS client) subscribe to the
    platform changelog from any docs page. The feed itself is Ghost's, on
    changelog.keboola.com; /changelog/ mirrors its newest entries. */}
<link rel="alternate" type="application/rss+xml" title="Keboola Platform Changelog" href="https://changelog.keboola.com/rss/" />
{/* Markdown autodiscovery: the same page as plain markdown, for tools and
    agents that read the page's <head> before fetching its text. */}
{twinUrl && <link rel="alternate" type="text/markdown" title="This page as Markdown" href={twinUrl} />}
<Default {...Astro.props}><slot /></Default>
<ClientRouter fallback="swap" />
<script is:inline>
  // Restore sidebar collapsed state synchronously — prevents FOUC on new tab open
  try {
    if (localStorage.getItem('kbc-sidebar-collapsed') === 'true') {
      document.documentElement.classList.add('sidebar-collapsed');
    }
  } catch(e) {}
</script>
<script is:inline>
  // Preserve sidebar state across view transitions
  document.addEventListener('astro:before-swap', function(e) {
    // Restore collapsed class on incoming document before swap
    try {
      if (localStorage.getItem('kbc-sidebar-collapsed') === 'true') {
        e.newDocument.documentElement.classList.add('sidebar-collapsed');
      }
    } catch(err) {}
    // Keep sidebar section open/closed state
    var currentDetails = document.querySelectorAll('.sidebar-content details');
    var newDetails = e.newDocument.querySelectorAll('.sidebar-content details');
    currentDetails.forEach(function(detail, i) {
      if (!newDetails[i]) return;
      var hasActive = newDetails[i].querySelector('[aria-current="page"]');
      newDetails[i].open = hasActive ? true : detail.open;
    });
  });
</script>
<!-- GTM noscript — only on production hostname -->
<noscript>
  <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WMTTBS"
    height="0" width="0" style="display:none;visibility:hidden"></iframe>
</noscript>
