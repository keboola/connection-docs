---
/**
 * Feedback.astro
 *
 * Stripe-style "Was this page helpful?" widget, rendered once per docs page
 * (via the Footer override). Three progressive steps:
 *   1. thumbs up / thumbs down (Lucide icons, inline SVG in currentColor so
 *      they follow the pressed and dark-mode colours)
 *   2. a heading + vertical radio list of reasons (Submit disabled until picked)
 *   3. selecting a reason reveals an optional comment box inline under it
 * On submit the form is replaced by a borderless thank-you line.
 *
 * A thumb-without-submit is still captured on page leave via
 * navigator.sendBeacon so the core signal isn't lost. Submissions POST to
 * /api/feedback. All styling lives in custom.css (no <style> here). The client
 * script (re)initialises on astro:page-load to survive view transitions.
 */

// The page's Markdown file, so a feedback issue can link to its source.
const { source = '' } = Astro.props as { source?: string };
---

<section class="b-feedback" data-feedback data-source={source} hidden>
  <p class="b-feedback-q">Was this page helpful?</p>

  <div class="b-feedback-buttons" data-fb-verdicts>
    <button type="button" class="b-feedback-btn" data-fb-verdict="up" aria-pressed="false">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"></path>
        <path d="M7 10v12"></path>
      </svg>
      Yes
    </button>
    <button type="button" class="b-feedback-btn" data-fb-verdict="down" aria-pressed="false">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22a3.13 3.13 0 0 1-3-3.88Z"></path>
        <path d="M17 14V2"></path>
      </svg>
      No
    </button>
  </div>

  <form class="b-feedback-followup" data-fb-followup hidden>
    <!-- The fieldset gives the radio group its accessible name. -->
    <fieldset class="b-feedback-fieldset">
      <legend class="b-feedback-followup-q" data-fb-followup-q></legend>
      <div class="b-feedback-options" data-fb-options></div>
    </fieldset>
    <!-- Comment box; moved inline under the selected option by the script. -->
    <div class="b-feedback-comment-wrap" data-fb-comment-wrap hidden>
      <label class="b-feedback-comment-label">
        <span class="b-feedback-sr">Additional comments</span>
        <textarea
          class="b-feedback-comment"
          data-fb-comment
          rows="3"
          maxlength="1000"
          aria-describedby="fb-comment-note"
          placeholder="(Optional) What should we change?"
        ></textarea>
      </label>
      <p class="b-feedback-note" id="fb-comment-note">
        Your comment goes to the Keboola docs team. Don't include credentials or personal data.
      </p>
    </div>
    <!-- Honeypot: hidden from humans; bots that fill it get dropped server-side. -->
    <input
      type="text"
      class="b-feedback-hp"
      data-fb-hp
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />
    <button type="submit" class="b-feedback-submit" data-fb-submit disabled>Submit</button>
  </form>

  <p class="b-feedback-thanks" data-fb-thanks role="status" tabindex="-1" hidden>
    Thank you for helping improve Keboola's documentation!
  </p>
  <!-- Shown after a 👎 for missing information or an unsolved problem, when Kai
       is available. data-ask-kai-open is AskKaiDrawer's own trigger; the
       script below only fills in the question. -->
  <button type="button" class="b-feedback-kai" data-fb-kai data-ask-kai-open hidden>
    Ask Kai about this page
  </button>
</section>

<script>
  // [value, label, description] — description omitted for "Another reason".
  const REASONS = {
    up: [
      ['accurate', 'Accurate', 'Accurately describes the product or feature.'],
      ['solved-problem', 'Solved my problem', 'Helped me resolve an issue.'],
      ['easy-to-understand', 'Easy to understand', 'Easy to follow and comprehend.'],
      ['helped-decide', 'Helped me decide to use the product', 'Convinced me to adopt the product or feature.'],
      ['another-reason', 'Another reason', ''],
    ],
    down: [
      ['inaccurate', 'Inaccurate', "Doesn't accurately describe the product or feature."],
      ['hard-to-understand', 'Hard to understand', 'Hard to follow or comprehend.'],
      ['missing-info', 'Missing information', "Doesn't have the information I need."],
      ['didnt-solve', "Didn't solve my problem", "Didn't help me resolve my issue."],
      ['another-reason', 'Another reason', ''],
    ],
  } as const;

  const apiBase = import.meta.env.DEV ? 'https://keboola-docs-beacon.vercel.app' : '';

  function storageKey() {
    return `kbc-fb:${location.pathname}`;
  }

  /**
   * Is there a backend to talk to?
   *
   * `/api/feedback` only exists on a Vercel deployment. On a static deploy —
   * the S3 sync in .github/workflows/main.yml still produces one — the widget
   * would render and POST into a 404. Probe once per session and fail CLOSED,
   * mirroring the Kai availability gate in AskKaiDrawer.astro.
   */
  const FB_FLAG = 'kbc-feedback-enabled';

  async function backendAvailable(): Promise<boolean> {
    let cached: string | null = null;
    try {
      cached = sessionStorage.getItem(FB_FLAG);
    } catch {}
    if (cached !== null) return cached === 'true';

    try {
      const res = await fetch(`${apiBase}/api/feedback`);
      const enabled = res.ok && Boolean((await res.json())?.enabled);
      // A static deploy stays static, so cache either verdict and stop probing
      // on every navigation.
      try {
        sessionStorage.setItem(FB_FLAG, String(enabled));
      } catch {}
      return enabled;
    } catch {
      // Network blip rather than a missing backend — stay hidden for now, but
      // don't cache it, so a later navigation probes again.
      return false;
    }
  }

  async function initFeedback() {
    const root = document.querySelector<HTMLElement>('[data-feedback]');
    if (!root || root.dataset.fbReady === '1') return;
    root.dataset.fbReady = '1';

    // Stays `hidden` from the markup unless a backend answers, so there is no
    // flash of a widget that then disappears.
    if (!(await backendAvailable())) return;
    // A navigation may have swapped the document while the probe was in
    // flight; this root is detached and a fresh one has already initialised.
    if (!root.isConnected) return;

    const verdictsWrap = root.querySelector<HTMLElement>('[data-fb-verdicts]')!;
    const followup = root.querySelector<HTMLFormElement>('[data-fb-followup]')!;
    const followupQ = root.querySelector<HTMLElement>('[data-fb-followup-q]')!;
    const optionsWrap = root.querySelector<HTMLElement>('[data-fb-options]')!;
    const commentWrap = root.querySelector<HTMLElement>('[data-fb-comment-wrap]')!;
    const comment = root.querySelector<HTMLTextAreaElement>('[data-fb-comment]')!;
    const honeypot = root.querySelector<HTMLInputElement>('[data-fb-hp]')!;
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-fb-submit]')!;
    const thanks = root.querySelector<HTMLElement>('[data-fb-thanks]')!;
    const kaiBtn = root.querySelector<HTMLButtonElement>('[data-fb-kai]')!;

    let verdict: 'up' | 'down' | null = null;
    let reason = '';
    let submitted = false;
    // One id per widget. A thumb sent on pagehide and a later Submit (after a
    // Back restore from the bfcache) share it, so the two rows read as one.
    let sid = '';
    try {
      sid = crypto.randomUUID();
    } catch {}

    // Already gave feedback on this page → show the thank-you, skip the form.
    let seen = false;
    try {
      seen = localStorage.getItem(storageKey()) === '1';
    } catch {}
    if (seen) {
      verdictsWrap.hidden = true;
      thanks.hidden = false;
      root.hidden = false;
      return;
    }
    root.hidden = false;

    function payload(extra: Record<string, unknown> = {}) {
      return JSON.stringify({
        verdict,
        reason,
        comment: comment.value.trim(),
        path: location.pathname,
        title: document.title,
        sid,
        source: root.dataset.source ?? '',
        hp: honeypot.value,
        ...extra,
      });
    }

    function markDone() {
      submitted = true;
      followup.hidden = true;
      verdictsWrap.hidden = true;
      thanks.hidden = false;
      // The focused Submit button just disappeared; move focus to the
      // confirmation instead of letting it fall back to <body>.
      thanks.focus();
      try {
        localStorage.setItem(storageKey(), '1');
      } catch {}
      offerKai();
    }

    // The docs didn't answer the reader's question, so offer the assistant that
    // might. Same availability gate as the drawer itself (AskKaiDrawer.astro).
    function offerKai() {
      if (verdict !== 'down' || (reason !== 'missing-info' && reason !== 'didnt-solve')) return;
      let kai = false;
      try {
        kai = sessionStorage.getItem('kbc-kai-enabled') === 'true';
      } catch {}
      if (!kai) return;
      const page = document.title.split(' | ')[0];
      const asked = comment.value.trim();
      const question = asked
        ? `I was reading "${page}" (${location.pathname}). ${asked}`
        : `I was reading "${page}" (${location.pathname}) and didn't find what I needed. Can you help?`;
      kaiBtn.hidden = false;
      kaiBtn.addEventListener('click', () => {
        // The drawer opens on this same click and focuses its input after
        // 30 ms; fill the question in after that.
        setTimeout(() => {
          const input = document.getElementById('ak-input') as HTMLTextAreaElement | null;
          if (!input) return;
          input.value = question;
          input.dispatchEvent(new Event('input'));
        }, 60);
      });
    }

    function selectReason(value: string, optionEl: HTMLElement) {
      reason = value;
      submitBtn.disabled = false;
      // Reveal the comment box directly under the chosen option (Stripe-style).
      // No focus move: arrow keys fire `change` while walking the radio group,
      // and pulling focus into the textarea would stop the walk at the first step.
      optionEl.insertAdjacentElement('afterend', commentWrap);
      commentWrap.hidden = false;
    }

    function selectVerdict(v: 'up' | 'down') {
      verdict = v;
      reason = '';
      submitBtn.disabled = true;
      commentWrap.hidden = true;
      verdictsWrap
        .querySelectorAll<HTMLButtonElement>('[data-fb-verdict]')
        .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.fbVerdict === v)));

      followupQ.textContent = v === 'up' ? 'What did you like?' : 'What could be better?';
      optionsWrap.innerHTML = '';
      for (const [value, label, desc] of REASONS[v]) {
        const id = `fb-r-${value}`;
        const option = document.createElement('div');
        option.className = 'b-feedback-option';
        const input = document.createElement('input');
        input.type = 'radio';
        input.name = 'fb-reason';
        input.id = id;
        input.value = value;
        input.className = 'b-feedback-radio';
        const lbl = document.createElement('label');
        lbl.className = 'b-feedback-option-text';
        lbl.htmlFor = id;
        lbl.innerHTML =
          `<span class="b-feedback-option-label"></span>` +
          (desc ? `<span class="b-feedback-option-desc"></span>` : '');
        lbl.querySelector('.b-feedback-option-label')!.textContent = label;
        if (desc) lbl.querySelector('.b-feedback-option-desc')!.textContent = desc;
        input.addEventListener('change', () => selectReason(value, option));
        option.append(input, lbl);
        optionsWrap.appendChild(option);
      }
      followup.hidden = false;
    }

    verdictsWrap.querySelectorAll<HTMLButtonElement>('[data-fb-verdict]').forEach((btn) => {
      btn.addEventListener('click', () => selectVerdict(btn.dataset.fbVerdict as 'up' | 'down'));
    });

    followup.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!verdict || !reason) return;
      // Fire-and-forget; the user gets their thank-you regardless of the
      // result. Log at debug level so a field failure is at least findable —
      // silence made an ingest error and a network error indistinguishable.
      fetch(`${apiBase}/api/feedback`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: payload(),
        keepalive: true,
      })
        .then((res) => {
          // 202 is res.ok too, but means a sink failed server-side.
          if (res.status !== 204) console.debug('[feedback] submit returned HTTP', res.status);
        })
        .catch((err) => console.debug('[feedback] submit failed:', err));
      markDone();
    });

    // Thumb clicked but never submitted → capture the verdict on the way out.
    function flushOnLeave() {
      if (!verdict || submitted) return;
      submitted = true; // guard against double-send
      try {
        navigator.sendBeacon(
          `${apiBase}/api/feedback`,
          // Never the comment: the reader didn't choose to send it.
          new Blob([payload({ abandoned: true, comment: '' })], { type: 'application/json' }),
        );
      } catch {}
    }
    // `pagehide` covers a real unload. Astro view-transition navigations don't
    // fire it, so `astro:before-swap` flushes too — and detaches both, because
    // the swap brings a fresh widget that registers its own pair. Without the
    // removal each navigation would leave a live listener behind holding this
    // closure's verdict, and they would all fire on the eventual unload.
    function onBeforeSwap() {
      flushOnLeave();
      window.removeEventListener('pagehide', flushOnLeave);
    }
    window.addEventListener('pagehide', flushOnLeave);
    document.addEventListener('astro:before-swap', onBeforeSwap, { once: true });
  }

  document.addEventListener('astro:page-load', initFeedback);
</script>
