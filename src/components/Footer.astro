---
/**
 * Footer.astro
 *
 * Override of Starlight's Footer that wraps the default footer markup and
 * also renders the page-global helpers once per page: AskKaiDrawer (it's a
 * `<dialog>` and needs to live in the body, not the head) and AnchorCopy.
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import AskKaiDrawer from './AskKaiDrawer.astro';
import Feedback from './Feedback.astro';
import SearchPersistFix from './SearchPersistFix.astro';
import AnchorCopy from './AnchorCopy.astro';

/* Feedback only on real docs pages. 404.astro and changelog.astro render through
   <StarlightPage>, which also gets this footer but has a synthetic entry with an
   empty body; a 404 would otherwise report the bad URL as a page. */
const entry: any = (Astro as any).locals?.starlightRoute?.entry;
const isDocsPage = typeof entry?.body === 'string' && entry.body.length > 0;
---
{isDocsPage && <Feedback source={entry.filePath} />}
<Default><slot /></Default>
<AskKaiDrawer />
<SearchPersistFix />
<AnchorCopy />
