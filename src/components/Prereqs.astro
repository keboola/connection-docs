---
// The prerequisites box, rendered from one place on every page that has one.
//
// Hand-written prerequisite lists drift apart from page to page, so the
// wording lives in prereqs.mjs and changes there, once.
//
// Up to four parts under the "Before you start" label:
//   "Where you are" → "When you finish": two cards with an arrow, from the
//     named slots `from` and `to`, on a step page of a course.
//   "You need": the shared items named by `needs`, then anything page-specific
//     passed as <li> children in the default slot. With neither, the heading
//     is left out.
//   a second list under the page's own `groupLabel`, for a page with two ways
//     through it; its items are <li slot="group"> children.
//   "What each tab needs": one card per tab, from `tabs`. A tab whose default
//     line is wrong for this page gets its own, as a named slot:
//     <span slot="prompt|ui|cli">…</span>. The label stays here.
// The wording lives in ./prereqs.mjs so the markdown twin (page-markdown.mjs)
// renders the same lists.
//
// Usage:  <Prereqs needs={['project']} tabs={3}>
//           <span slot="from">a project with empty Storage.</span>
//           <span slot="to">six tables in Storage.</span>
//         </Prereqs>
//         <Prereqs needs={['project', 'google']} tabs={2}>
//           <li><strong>The table <code>x</code></strong> from the previous page.</li>
//         </Prereqs>
//         <Prereqs id="before-you-start" needs={['project']} groupLabel="Depending on how you build">
//           <li><strong>Git,</strong> which pushes the app's code.</li>
//           <li slot="group"><strong>With an AI agent:</strong> …</li>
//         </Prereqs>
//         <Prereqs needs={[]}>  (only the page's own items)
//
// Keep the opening tag on one line: the markdown twin reads its props line by line.
// Styles: .prereqs, .fromto and .prereqs__tab in custom.css.

import { Icon } from '@astrojs/starlight/components';
import { LABELS, SHARED, TABS } from './prereqs.mjs';

interface Props {
  /** Shared "You need" items, in the order they should appear. */
  needs?: Array<'project' | 'projectWithKai' | 'google' | 'kai'>;
  /** How many tabs the page offers: 3 (Prompt, UI, CLI / API), 2 (Prompt, UI) or 0. */
  tabs?: 0 | 2 | 3;
  /** Anchor for the box when the page links to it. Leave it out on a page with several boxes. */
  id?: string;
  /**
   * Label of the second list, whose items are the <li slot="group"> children.
   * Not called `group`: in MDX a named slot arrives as a prop of the same name
   * (astro/jsx-runtime transformSlots) and would overwrite it.
   */
  groupLabel?: string;
}

const { needs = ['project'], tabs = 0, id, groupLabel } = Astro.props;

// MDX wraps a slot's multi-line text in <p>, which breaks the line after the label
const slotHtml = async (name: string) =>
  Astro.slots.has(name) ? (await Astro.slots.render(name)).replace(/<\/?p>/g, '') : null;

const from = await slotHtml('from');
const to = await slotHtml('to');
const items = needs.filter((k) => SHARED[k]);
const hasGroup = Boolean(groupLabel) && Astro.slots.has('group');
const tabLines = [];
for (const t of TABS.slice(0, tabs)) {
  const own = await slotHtml(t.key);
  tabLines.push({ key: t.key, label: t.label, html: own ?? t.html });
}
// Rendered once here rather than with <slot />, so a page that passes only the
// named slots does not get an empty "You need" heading
const ownItems = Astro.slots.has('default') ? (await Astro.slots.render('default')).trim() : '';
---

<div class="prereqs" id={id}>
  <p class="prereqs__label">{LABELS.box}</p>
  {
    (from || to) && (
      <div class="fromto">
        {from && (
          <p class="fromto__card">
            <span class="fromto__label">{LABELS.from}</span>
            <span set:html={from} />
          </p>
        )}
        {from && to && <span class="fromto__arrow" aria-hidden="true">→</span>}
        {to && (
          <p class="fromto__card fromto__card--to">
            <span class="fromto__label">{LABELS.to}</span>
            <span set:html={to} />
          </p>
        )}
      </div>
    )
  }
  {
    (items.length > 0 || ownItems) && (
      <Fragment>
        <p class="prereqs__group">{LABELS.needs}</p>
        <ul class="prereqs__list">
          {items.map((key) => <li set:html={SHARED[key]} />)}
          <Fragment set:html={ownItems} />
        </ul>
      </Fragment>
    )
  }
  {hasGroup && (
    <Fragment>
      <p class="prereqs__group">{groupLabel}</p>
      <ul class="prereqs__list">
        <slot name="group" />
      </ul>
    </Fragment>
  )}
  {
    tabLines.length > 0 && (
      <Fragment>
        <p class="prereqs__group">{LABELS.tabs}</p>
        <div class="not-content">
        <ul class="prereqs__tabs">
          {tabLines.map((t) => (
            <li class="prereqs__tab">
              <span class="prereqs__tabname">
                {t.key === 'prompt' && <Icon name="comment" size="1.1em" />}
                {t.key === 'ui' && <Icon name="laptop" size="1.1em" />}
                {t.key === 'cli' && <span class="prereqs__glyph" aria-hidden="true">&gt;_</span>}
                {t.label}
              </span>
              <span set:html={t.html} />
            </li>
          ))}
        </ul>
        </div>
      </Fragment>
    )
  }
</div>
